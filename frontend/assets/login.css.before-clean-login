.sr-only{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
/* Premium entrance + micro-interactions (login/register) */
@keyframes milanRise{0%{opacity:0;transform:translateY(18px) scale(.985)}100%{opacity:1;transform:none}}
.milan-container{animation:milanRise .6s cubic-bezier(.16,.84,.44,1) both}
.login-card{animation:milanRise .7s cubic-bezier(.16,.84,.44,1) .08s both}
.logo-center img{transition:transform .4s cubic-bezier(.16,.84,.44,1)}
.logo-center img:hover{transform:scale(1.06) rotate(-3deg)}
.input-field{transition:border-color .2s,box-shadow .25s,background .2s!important}
.input-field:focus{transform:translateZ(0)}
.login-button,.did-button{transition:transform .12s cubic-bezier(.16,.84,.44,1),box-shadow .25s,filter .2s!important}
.login-button:active{transform:scale(.97)}
.login-button{position:relative;overflow:hidden}
.login-button::after{content:"";position:absolute;top:0;left:-120%;width:60%;height:100%;background:linear-gradient(120deg,transparent,rgba(255,255,255,.35),transparent);transform:skewX(-20deg);transition:left .6s}
.login-button:hover::after{left:140%}
.feature-item{transition:transform .25s}
.feature-item:hover{transform:translateX(4px)}
.feature-icon{transition:transform .3s,box-shadow .3s}
.feature-item:hover .feature-icon{transform:scale(1.08);box-shadow:0 6px 18px rgba(245,158,11,.25)}
.tab{transition:all .2s cubic-bezier(.16,.84,.44,1)!important}
@media (prefers-reduced-motion:reduce){.milan-container,.login-card{animation:none}}

