<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Milan</title>
  <link rel="stylesheet" href="/milan-core.css">
  <link rel="stylesheet" href="/milan-ui.css">
  <link rel="stylesheet" href="/premium.css">
  <link rel="stylesheet" href="/assets/css/app-layout.css">
  <link rel="stylesheet" href="/assets/css/milan-visual-base.css">
  <link rel="stylesheet" href="/assets/css/milan-web5-engine.css">
</head>
<body>
<div class="app">
<header class="topbar">
  <div class="brand">
    <div class="brand-logo" role="link" tabindex="0" title="Home"><img class="brand-logo-img" src="/assets/milan-logo-circle.png" alt="Milan Home"></div>
    <div class="brand-text"><div class="brand-text-inner"><div><strong>Milan</strong><span>Your Space. Your People.</span></div></div></div>
  </div>
  <div class="search"><input id="globalSearch" type="search" placeholder="Search people, posts, tags..."></div>
  <div class="top-actions">
    <button id="logoutBtn" type="button" class="icon-btn" title="Logout">↪</button>
    <button class="icon-btn" title="Chat">💬</button>
    <button class="icon-btn" title="Music">🎵</button>
    <button class="icon-btn" title="Theme">◐</button>
    <button class="icon-btn" title="Notifications">🔔</button>
  </div>
</header>
<main class="layout">
<aside class="sidebar card">
  <div class="profile">
    <label class="milan-avatar-upload" for="editProfilePhoto">
      <div class="avatar" id="myAvatar">M</div><span class="milan-avatar-upload-icon">📷</span>
      <input id="editProfilePhoto" type="file" accept="image/*" hidden>
      <img id="editProfilePhotoPreview" alt="Profile photo">
    </label>
    <h2 id="myName"></h2><p id="myEmail"></p>
    <span id="myDid" class="milan-data-bridge" aria-hidden="true"></span>
    <span id="myDwn" class="milan-data-bridge" aria-hidden="true"></span>
    <span id="privacyScore" class="milan-data-bridge" aria-hidden="true"></span>
    <span id="privacyBar" class="milan-data-bridge" aria-hidden="true"></span>
    <div class="profile-stats"><div class="profile-stat"><b id="peopleCount">0</b><span>People</span></div><div class="profile-stat"><b id="postCount">0</b><span>Posts</span></div><div class="profile-stat"><b id="notifCount">0</b><span>Alerts</span></div></div>
  </div>
  <nav class="nav">
    <button class="active">🏠 Home Feed</button><button>👤 My Posts</button><button>🌍 Public Feed</button><button>🔖 Saved</button>
    <button>💬 Messages</button><button>🎵 Music</button><button>🔔 Notifications</button>
    <button id="editProfileBtn" type="button">⚙ Edit Profile</button><button>🛡 Privacy</button><button class="accent">🤖 MILAN AI</button>
  </nav>
</aside>
<section>
  <div class="composer card">
    <div class="composer-row"><div class="mini-avatar" id="composerAvatar">M</div><textarea id="postText" placeholder="What's happening in your space?"></textarea></div>
    <div class="composer-bottom"><div class="composer-tools"><button class="tool">🖼</button><button class="tool">📎</button><button class="tool">😊</button><button class="tool">🔒</button></div><button class="publish" id="publishBtn">Publish</button></div>
  </div>

  <section id="milanHomeFeed" class="milan-home-feed" aria-live="polite">
    <div class="milan-feed-header">
      <div>
        <strong>Home Feed</strong>
        <span>Your latest posts</span>
      </div>
      <button id="milanFeedRefresh" type="button">↻ Refresh</button>
    </div>
    <div id="milanFeedList"></div>
  </section>
</section>
<aside class="rightbar">
  <div class="right-card card"><h3>People to connect</h3><div class="person"><div class="person-avatar">A</div><div class="person-info"><b>Alex</b><span>Developer</span></div><button class="follow">Follow</button></div><div class="person"><div class="person-avatar">R</div><div class="person-info"><b>Rahul</b><span>Designer</span></div><button class="follow">Follow</button></div></div>
  <div class="right-card card"><h3>Recent activity</h3><div class="person"><div class="person-avatar">💬</div><div class="person-info"><b>New message</b><span>2 minutes ago</span></div></div><div class="person"><div class="person-avatar">❤</div><div class="person-info"><b>Your post received a like</b><span>12 minutes ago</span></div></div></div>
</aside>
</main>
</div>
<nav class="mobile-nav"><a href="#" class="active">🏠<br>Home</a><a href="/chat">💬<br>Chat</a><a href="/music">🎵<br>Music</a><a href="#">🔔<br>Alerts</a><a href="#">👤<br>Profile</a></nav>



<script src="/milan-creative-mode.js" defer></script>
<script src="/assets/js/milan-creative-bridge.js" defer></script>
<script src="/milan-polish.js" defer></script>
<script src="/assets/js/milan-ui-actions.js?v=1" defer></script>
<script src="/assets/js/app-page-actions.js" defer></script>
<script src="/assets/js/milan-web5-motion.js" defer></script>
<script src="/assets/js/milan-did-ring.js" defer></script>
<script src="/assets/js/milan-identity-status.js" defer></script>
<script src="/assets/js/milan-identity-intelligence.js" defer></script>
<script src="/assets/js/milan-identity-status-sync.js" defer></script>


</body>
</html>

<style>
/* MILAN HOME UI V2 */
:root{
  --m-bg:#071126;
  --m-panel:rgba(10,24,56,.78);
  --m-panel-2:rgba(16,31,67,.72);
  --m-line:rgba(255,255,255,.08);
  --m-text:#f7f8ff;
  --m-muted:#94a3c7;
  --m-pink:#df46c8;
  --m-orange:#ff9c38;
  --m-green:#42dfb5;
}

body{
  background:
    radial-gradient(circle at 15% 0%,rgba(94,92,255,.16),transparent 28%),
    radial-gradient(circle at 90% 8%,rgba(223,70,200,.12),transparent 26%),
    linear-gradient(180deg,#071126 0%,#0a1430 45%,#090f22 100%) !important;
}

#appView{
  min-height:100vh;
}

.layout{
  width:min(1420px,calc(100% - 28px)) !important;
  margin:20px auto !important;
  grid-template-columns:280px minmax(0,1fr) 310px !important;
  gap:18px !important;
  align-items:start !important;
}

.leftRail,
.rightRail,
.centerRail{
  min-width:0;
}

.card,
.profileCard,
.menu,
.right-card{
  background:linear-gradient(180deg,rgba(18,34,72,.88),rgba(8,19,45,.9)) !important;
  border:1px solid var(--m-line) !important;
  box-shadow:0 18px 55px rgba(0,0,0,.18) !important;
  border-radius:22px !important;
}

.profileCard{
  padding:18px !important;
}

.menu{
  margin-top:14px !important;
  padding:10px !important;
}

.menu button{
  width:100%;
  min-height:46px;
  margin:4px 0 !important;
  border-radius:14px !important;
  transition:transform .18s ease,filter .18s ease !important;
}

.menu button:hover{
  transform:translateX(2px);
  filter:brightness(1.08);
}

.menu button.active{
  background:linear-gradient(135deg,var(--m-orange),var(--m-pink)) !important;
  box-shadow:0 12px 28px rgba(223,70,200,.2) !important;
}

.heroIntro{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  padding:20px 4px 8px;
}

.heroIntro h1{
  margin:0;
  font-size:clamp(25px,3vw,38px);
  line-height:1.05;
  letter-spacing:-.03em;
}

.heroIntro p{
  margin:7px 0 0;
  color:var(--m-muted);
  font-size:14px;
}

.quickStats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin:0 0 15px;
}

.quickStat{
  padding:15px 16px;
  border-radius:18px;
  background:rgba(255,255,255,.035);
  border:1px solid var(--m-line);
}

.quickStat .k{
  color:var(--m-muted);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.08em;
}

.quickStat .v{
  margin-top:5px;
  font-size:22px;
  font-weight:800;
}

.composer{
  margin-top:0 !important;
}

.composer textarea,
#postText{
  min-height:118px !important;
  border-radius:18px !important;
  background:rgba(4,12,31,.72) !important;
  border:1px solid rgba(255,255,255,.09) !important;
}

.post{
  margin-top:15px !important;
}

.postHead{
  padding-bottom:10px !important;
}

.postBody{
  padding-top:4px !important;
}

.rightRail .right-card{
  padding:18px !important;
  margin-bottom:15px !important;
}

.rightRail h3{
  margin-top:0 !important;
  font-size:13px !important;
  text-transform:uppercase;
  letter-spacing:.08em;
  color:#9eacd0;
}

.person{
  padding:10px 0 !important;
  border-bottom:1px solid rgba(255,255,255,.06);
}

.person:last-child{
  border-bottom:0;
}

.follow{
  min-width:74px !important;
}

.empty{
  min-height:180px;
  display:grid;
  place-items:center;
  text-align:center;
  padding:28px !important;
  border:1px dashed rgba(255,255,255,.09);
  border-radius:20px;
  color:var(--m-muted);
  background:rgba(255,255,255,.018);
}

@media(max-width:1120px){
  .layout{
    grid-template-columns:235px minmax(0,1fr) !important;
  }
  .rightRail{
    display:none;
  }
}

@media(max-width:760px){
  .layout{
    width:min(100% - 16px,1420px) !important;
    grid-template-columns:1fr !important;
    margin:8px auto !important;
  }
  .leftRail{
    position:static !important;
  }
  .menu{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:6px;
  }
  .menu button{
    margin:0 !important;
  }
  .quickStats{
    grid-template-columns:1fr 1fr 1fr;
  }
}

@media(max-width:520px){
  .heroIntro{
    align-items:flex-start;
    flex-direction:column;
  }
  .quickStats{
    grid-template-columns:1fr;
  }
  .menu{
    grid-template-columns:1fr;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded",()=>{
  const center=document.querySelector(".centerRail") || document.querySelector("main.layout > section") || document.querySelector(".main");
  if(!center || document.getElementById("milanHomeIntro")) return;

  const wrap=document.createElement("div");
  wrap.id="milanHomeIntro";
  wrap.innerHTML=`
    <div class="heroIntro">
      <div>
        <h1>Welcome back to MILAN</h1>
        <p>Your people, your data, your space.</p>
      </div>
    </div>
    <div class="quickStats">
      <div class="quickStat"><div class="k">People</div><div class="v" id="uiPeopleCount">0</div></div>
      <div class="quickStat"><div class="k">Visible posts</div><div class="v" id="uiPostCount">0</div></div>
      <div class="quickStat"><div class="k">Privacy</div><div class="v" id="uiPrivacyScore">100%</div></div>
    </div>
  `;

  center.prepend(wrap);

  const sync=()=>{
    const p=document.getElementById("peopleCount");
    const posts=document.getElementById("postCount");
    const privacy=document.getElementById("privacyScore");
    const a=document.getElementById("uiPeopleCount");
    const b=document.getElementById("uiPostCount");
    const c=document.getElementById("uiPrivacyScore");
    if(a && p) a.textContent=p.textContent;
    if(b && posts) b.textContent=posts.textContent;
    if(c && privacy) c.textContent=privacy.textContent;
  };

  sync();
  setInterval(sync,1500);
});
</script>
