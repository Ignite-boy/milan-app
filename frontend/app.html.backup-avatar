<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Milan</title>
  <link rel="stylesheet" href="/milan-core.css">
  <link rel="stylesheet" href="/milan-ui.css">
  <link rel="stylesheet" href="/premium.css">

<style id="milan-fixed-layout">
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body { background: #0a0e1a; color: #e8edf5; font-family: Inter, system-ui, -apple-system, sans-serif; line-height:1.5; }

 .app { min-height:100vh; display:flex; flex-direction:column; }

  /* TOPBAR - DESKTOP FIX */
 .topbar {
    display:flex; align-items:center; justify-content:space-between;
    gap:16px; padding:12px 20px;
    background: rgba(15,23,42,0.9); backdrop-filter: blur(12px);
    border-bottom:1px solid #1e293b;
    position:sticky; top:0; z-index:100;
    flex-wrap: nowrap!important;
  }
 .brand{display:flex; align-items:center; gap:12px; flex-shrink:0}
 .brand-logo img{display:block}
 .brand-text strong{font-size:18px; line-height:1.1; display:block}
 .brand-text span{font-size:12px; color:#94a3b8; display:block; white-space:nowrap!important;}

 .search{flex:1 1 auto; max-width:480px; min-width:200px;}
 .search input{
    width:100%; background:#111827; border:1px solid #1e293b;
    color:#e8edf5; padding:10px 16px; border-radius:999px; outline:none;
  }
 .top-actions{display:flex; gap:8px; flex-shrink:0; align-items:center;}
 .icon-btn{
    width:38px; height:38px; border-radius:50%; background:#1e293b;
    border:1px solid #2a3a5a; color:#e8edf5; cursor:pointer;
    display:grid; place-items:center; font-size:16px;
  }

  /* LAYOUT - MAIN FIX FOR DESKTOP VISIBILITY */
 .layout {
    display:grid;
    grid-template-columns: 300px minmax(0, 1fr) 340px;
    gap:20px;
    width:100%;
    max-width:1440px;
    margin:0 auto;
    padding:20px;
    align-items:start;
  }
 .layout > section { min-width:0; } /* prevents overflow */

 .card { background: #111827; border:1px solid #1e293b; border-radius:16px; padding:16px; margin-bottom:0; }

  /* SIDEBAR */
 .sidebar{position:sticky; top:78px; height:fit-content; display:flex; flex-direction:column; gap:16px;}
 .profile{text-align:center}
 .profile h2{margin:12px 0 4px; font-size:18px}
 .profile p{margin:0; color:#94a3b8; font-size:13px}
 .profile-stats{display:flex; justify-content:space-around; margin-top:16px; padding-top:16px; border-top:1px solid #1e293b;}
 .profile-stat b{display:block; font-size:16px}.profile-stat span{font-size:11px; color:#94a3b8; text-transform:uppercase}

 .nav{display:flex; flex-direction:column; gap:6px}
 .nav button{
    width:100%; text-align:left; background:transparent; border:none;
    color:#94a3b8; padding:10px 12px; border-radius:10px; cursor:pointer; font-size:14px;
  }
 .nav button.active,.nav button:hover{background:#1e293b; color:#e8edf5}
 .nav button.accent{background: linear-gradient(135deg, #6366f1, #8b5cf6); color:white; margin-top:8px}

  /* COMPOSER */
 .composer-row{display:flex; gap:12px; align-items:flex-start;}
 .composer textarea{
    flex:1; width:100%!important; min-height:56px; resize:none;
    background:#0a0e1a; border:1px solid #1e293b; border-radius:12px;
    color:#e8edf5; padding:12px 14px; outline:none; font-family:inherit;
  }
 .composer-bottom{display:flex; justify-content:space-between; align-items:center; margin-top:12px; padding-top:12px; border-top:1px solid #1e293b;}
 .composer-tools{display:flex; gap:8px}
 .tool{width:32px; height:32px; border-radius:8px; background:#1e293b; border:none; cursor:pointer}
 .publish{background:#6366f1; color:white; border:none; padding:8px 18px; border-radius:999px; font-weight:600; cursor:pointer}

  /* RIGHTBAR */
 .rightbar{display:flex; flex-direction:column; gap:20px; position:sticky; top:78px; height:fit-content}
 .right-card h3{margin:0 0 14px; font-size:14px; letter-spacing:0.5px; text-transform:uppercase; color:#94a3b8}
 .person{display:flex; align-items:center; gap:10px; flex-wrap:nowrap; margin-bottom:14px}
 .person:last-child{margin-bottom:0}
 .person-avatar{
    width:40px; height:40px; border-radius:50%; background:#2a3a5a;
    display:grid; place-items:center; flex-shrink:0; font-weight:600;
  }
 .person-info{flex:1; min-width:0; overflow:hidden}
 .person-info b,.person-info span{display:block; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; line-height:1.2}
 .person-info b{font-size:14px}.person-info span{font-size:12px; color:#94a3b8}
 .follow{margin-left:auto; background:#1e293b; border:1px solid #2a3a5a; color:#e8edf5; padding:6px 14px; border-radius:999px; font-size:12px; cursor:pointer; flex-shrink:0}

  /* AVATAR - CORRECTED */
 .avatar,.mini-avatar,.person-avatar, #myAvatar, #composerAvatar {
    background-size: cover!important;
    background-position: center!important;
    background-repeat: no-repeat!important;
    border-radius: 50%;
    flex-shrink: 0;
    overflow:hidden;
  }
 .avatar,.mini-avatar,.person-avatar{width:48px; height:48px}
  #myAvatar{width:72px; height:72px; margin:0 auto; display:grid; place-items:center; font-size:24px; background:#2a3a5a}
  #composerAvatar{width:42px; height:42px; display:grid; place-items:center; background:#2a3a5a}
 .milan-avatar-upload{position:relative; display:inline-block; cursor:pointer}
 .milan-avatar-upload-icon{position:absolute; bottom:0; right:0; background:#6366f1; width:22px; height:22px; border-radius:50%; display:grid; place-items:center; font-size:12px; border:2px solid #111827}

  /* MOBILE */
 .mobile-nav { display: none; }
  @media (max-width: 1100px) {
   .layout{grid-template-columns: 280px 1fr; }
   .rightbar{display:none}
  }
  @media (max-width: 768px) {
   .layout{grid-template-columns:1fr; padding:12px; margin-bottom:70px}
   .sidebar,.rightbar{position:static}
   .topbar{flex-wrap:wrap!important}
   .search{order:3; flex-basis:100%; max-width:100%}
   .mobile-nav { display: flex; justify-content: space-around; background: #111827; border-top:1px solid #1e293b; padding:8px 0; position: fixed; bottom: 0; left: 0; right: 0; z-index:200 }
   .mobile-nav a{color:#94a3b8; text-decoration:none; text-align:center; font-size:11px}
   .mobile-nav a.active{color:#6366f1}
  }
</style>
</head>

<body>
<div class="app">

<header class="topbar">
  <div class="brand">
    <div class="brand-logo" style="background:transparent!important;box-shadow:none!important;">
      <img src="/assets/milan-logo.png" style="width:44px;height:44px;object-fit:contain;">
    </div>
    <div class="brand-text">
      <div style="display:flex;align-items:center;gap:12px;">
        <div>
          <strong>Milan</strong>
          <span>Your Space. Your People.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="search">
    <input id="globalSearch" type="search" placeholder="Search people, posts, tags...">
  </div>

  <div class="top-actions">
    <button id="logoutBtn" type="button" class="icon-btn" title="Logout" >↪</button>
    <button class="icon-btn" title="Chat" onclick="location.href='/chat'">💬</button>
    <button class="icon-btn" title="Music" onclick="location.href='/music'">🎵</button>
    <button class="icon-btn" title="Theme">◐</button>
    <button class="icon-btn" title="Notifications">🔔</button>
  </div>
</header>

<main class="layout">

<aside class="sidebar card">
  <div class="profile">
    <label class="milan-avatar-upload" for="editProfilePhoto">
      <div class="avatar" id="myAvatar">M</div>
      <span class="milan-avatar-upload-icon">📷</span>
      <input id="editProfilePhoto" type="file" accept="image/*" hidden>
      <img id="editProfilePhotoPreview" alt="Profile photo" style="display:none">
    </label>
    <h2 id="myName">MILAN User</h2>
    <p id="myEmail">Welcome to Milan</p>

    <div class="profile-stats">
      <div class="profile-stat"><b id="peopleCount">0</b><span>People</span></div>
      <div class="profile-stat"><b id="postCount">0</b><span>Posts</span></div>
      <div class="profile-stat"><b id="notifCount">0</b><span>Alerts</span></div>
    </div>
  </div>

  <nav class="nav">
    <button class="active">🏠 Home Feed</button>
    <button>👤 My Posts</button>
    <button>🌍 Public Feed</button>
    <button>🔖 Saved</button>
    <button onclick="location.href='/chat'">💬 Messages</button>
    <button onclick="location.href='/music'">🎵 Music</button>
    <button>🔔 Notifications</button>
    <button id="editProfileBtn" type="button">⚙ Edit Profile</button>
    <button>🛡 Privacy</button>
    <button class="accent">🤖 MILAN AI</button>
  </nav>
</aside>

<section>
  <div class="composer card">
    <div class="composer-row">
      <div class="mini-avatar" id="composerAvatar">M</div>
      <textarea id="postText" placeholder="What's happening in your space?"></textarea>
    </div>
    <div class="composer-bottom">
      <div class="composer-tools">
        <button class="tool">🖼</button>
        <button class="tool">📎</button>
        <button class="tool">😊</button>
        <button class="tool">🔒</button>
      </div>
      <button class="publish" id="publishBtn">Publish</button>
    </div>
  </div>
</section>

<aside class="rightbar">
  <div class="right-card card">
    <h3>People to connect</h3>
    <div class="person">
      <div class="person-avatar">A</div>
      <div class="person-info"><b>Alex</b><span>Developer</span></div>
      <button class="follow">Follow</button>
    </div>
    <div class="person">
      <div class="person-avatar">R</div>
      <div class="person-info"><b>Rahul</b><span>Designer</span></div>
      <button class="follow">Follow</button>
    </div>
  </div>
  <div class="right-card card">
    <h3>Recent activity</h3>
    <div class="person">
      <div class="person-avatar">💬</div>
      <div class="person-info"><b>New message</b><span>2 minutes ago</span></div>
    </div>
    <div class="person">
      <div class="person-avatar">❤</div>
      <div class="person-info"><b>Your post received a like</b><span>12 minutes ago</span></div>
    </div>
  </div>
</aside>

</main>
</div>

<nav class="mobile-nav">
  <a href="#" class="active">🏠<br>Home</a>
  <a href="/chat">💬<br>Chat</a>
  <a href="/music">🎵<br>Music</a>
  <a href="#">🔔<br>Alerts</a>
  <a href="#">👤<br>Profile</a>
</nav>










<script>
(function() {
    // Wait for DOM to be ready
    function initUpload() {
        const photoInput = document.getElementById("editProfilePhoto");
        if (!photoInput) return;

        // Remove any existing listener to prevent duplicates
        photoInput.removeEventListener("change", handleUpload);
        photoInput.addEventListener("change", handleUpload);
    }

    function handleUpload(e) {
        const file = this.files?.[0];
        if (!file || !file.type.startsWith("image/")) {
            this.value = "";
            return;
        }
        const reader = new FileReader();
        reader.onload = function(e) {
            const dataUrl = e.target.result;
            // Save to localStorage
            localStorage.setItem("milanAvatar", dataUrl);

            // Update all avatar elements
            const avatarIds = ["myAvatar", "composerAvatar"];
            avatarIds.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.style.backgroundImage = 'url("' + dataUrl + '")';
                    el.style.backgroundSize = "cover";
                    el.style.backgroundPosition = "center";
                    el.style.backgroundRepeat = "no-repeat";
                    el.textContent = "";
                }
            });

            // Update any .avatar, .mini-avatar in the feed
            document.querySelectorAll('.avatar, .mini-avatar').forEach(el => {
                if (el.id !== "myAvatar" && el.id !== "composerAvatar") {
                    el.style.backgroundImage = 'url("' + dataUrl + '")';
                    el.style.backgroundSize = "cover";
                    el.style.backgroundPosition = "center";
                    el.style.backgroundRepeat = "no-repeat";
                    el.textContent = "";
                }
            });

            // Update preview in dialog if it exists
            const preview = document.getElementById("editProfilePhotoPreview");
            if (preview) {
                preview.src = dataUrl;
                preview.style.display = "block";
            }

            // Update global me object if exists
            if (window.me && window.me.profile) {
                window.me.profile.avatar = dataUrl;
            }

            // Sync with backend
            const token = localStorage.getItem("milanToken") || "";
            if (token) {
                fetch("/api/profile", {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + token
                    },
                    body: JSON.stringify({ avatar: dataUrl })
                }).catch(err => console.warn("Backend avatar save failed:", err));
            }
        };
        reader.readAsDataURL(file);
    }

    // Run on DOM ready and after any dynamic content loads
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initUpload);
    } else {
        initUpload();
    }
})();
</script>


<script>
(function() {
    function restoreAvatar() {
        const saved = localStorage.getItem("milanAvatar");
        if (!saved) return;
        const targets = ["myAvatar", "composerAvatar"];
        targets.forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.style.backgroundImage = 'url("' + saved + '")';
                el.style.backgroundSize = "cover";
                el.style.backgroundPosition = "center";
                el.style.backgroundRepeat = "no-repeat";
                el.textContent = "";
            }
        });
        document.querySelectorAll('.avatar, .mini-avatar').forEach(el => {
            if (el.id !== "myAvatar" && el.id !== "composerAvatar") {
                el.style.backgroundImage = 'url("' + saved + '")';
                el.style.backgroundSize = "cover";
                el.style.backgroundPosition = "center";
                el.style.backgroundRepeat = "no-repeat";
                el.textContent = "";
            }
        });
        if (window.me && window.me.profile) {
            window.me.profile.avatar = saved;
        }
    }
    // Run immediately and after DOM ready
    restoreAvatar();
    document.addEventListener("DOMContentLoaded", restoreAvatar);
})();
</script>

</body>
</html>
