<script>
(function(){
  function setAvatars() {
    const saved = localStorage.getItem("milanAvatar");
    if (!saved) return;
    // Update all avatar elements
    document.querySelectorAll('#myAvatar, #composerAvatar, .avatar, .mini-avatar').forEach(el => {
      if (!el) return;
      // Only set if it's empty or default (single letter) or no background
      const bg = el.style.backgroundImage;
      const text = el.textContent?.trim() || '';
      const isDefault = (text.length === 1 && /[A-Z]/.test(text)) || !bg || bg === 'none' || bg === '';
      if (isDefault) {
        el.style.backgroundImage = 'url("' + saved + '")';
        el.style.backgroundSize = 'cover';
        el.style.backgroundPosition = 'center';
        el.style.backgroundRepeat = 'no-repeat';
        el.innerHTML = '';
      }
    });
    // Update window.me.profile.avatar if exists
    if (window.me && window.me.profile) {
      window.me.profile.avatar = saved;
    }
  }

  // Run immediately and repeatedly
  setAvatars();
  let count = 0;
  const interval = setInterval(() => {
    setAvatars();
    count++;
    if (count > 20) clearInterval(interval);
  }, 300);

  // Also run on DOM ready and load
  document.addEventListener('DOMContentLoaded', () => setTimeout(setAvatars, 200));
  window.addEventListener('load', () => setTimeout(setAvatars, 400));

  // Watch for new avatar elements
  const observer = new MutationObserver(() => setAvatars());
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
<script>
// Override avatarMarkup to always use localStorage avatar if available
const origAvatarMarkup = window.avatarMarkup;
window.avatarMarkup = function(avatar, name) {
    if (!avatar) {
        const saved = localStorage.getItem("milanAvatar");
        if (saved) avatar = saved;
    }
    const fallback = (name || "M").trim().charAt(0).toUpperCase() || "M";
    if (avatar && (/^data:image\//.test(avatar) || /^https?:\/\//.test(avatar))) {
        return '<img src="' + avatar.replace(/"/g, '&quot;') + '" alt="Profile">';
    }
    return fallback;
};
</script>
<script>
(function(){
  function restoreAvatars() {
    const saved = localStorage.getItem("milanAvatar");
    if (!saved) return;
    // Update all avatar elements
    document.querySelectorAll('#myAvatar, #composerAvatar, .avatar, .mini-avatar').forEach(el => {
      if (!el) return;
      // Only set if empty or default (single letter) or no background image
      const bg = el.style.backgroundImage;
      const text = el.textContent?.trim() || '';
      const isDefault = (text.length === 1 && /[A-Z]/.test(text)) || !bg || bg === 'none' || bg === '';
      if (isDefault) {
        el.style.backgroundImage = 'url("' + saved + '")';
        el.style.backgroundSize = 'cover';
        el.style.backgroundPosition = 'center';
        el.style.backgroundRepeat = 'no-repeat';
        el.textContent = '';
      }
    });
    // Update window.me.profile if exists
    if (window.me && window.me.profile) {
      window.me.profile.avatar = saved;
    }
  }

  // Run immediately and repeatedly to catch dynamic content
  restoreAvatars();
  let count = 0;
  const interval = setInterval(() => {
    restoreAvatars();
    count++;
    if (count > 15) clearInterval(interval);
  }, 400);

  // Also run after DOM ready and full load
  if (document.readyState !== 'complete') {
    document.addEventListener('DOMContentLoaded', () => setTimeout(restoreAvatars, 200));
    window.addEventListener('load', () => setTimeout(restoreAvatars, 300));
  }

  // Watch for new avatar elements added dynamically
  const observer = new MutationObserver(() => restoreAvatars());
  observer.observe(document.body, { childList: true, subtree: true });
})();
</script>
<script>
(function() {
    const photoInput = document.getElementById("editProfilePhoto");
    if (photoInput) {
        photoInput.addEventListener("change", function() {
            const file = this.files?.[0];
            if (!file || !file.type.startsWith("image/")) {
                this.value = "";
                return;
            }
            const reader = new FileReader();
            reader.onload = function(e) {
                const dataUrl = e.target.result;
                localStorage.setItem("milanAvatar", dataUrl);
                // Update preview
                const preview = document.getElementById("editProfilePhotoPreview");
                if (preview) {
                    preview.src = dataUrl;
                    preview.style.display = "block";
                }
                // Update main avatar
                const avatarEl = document.getElementById("myAvatar");
                if (avatarEl) {
                    avatarEl.textContent = "";
                    avatarEl.style.backgroundImage = 'url("' + dataUrl + '")';
                    avatarEl.style.backgroundSize = "cover";
                    avatarEl.style.backgroundPosition = "center";
                    avatarEl.style.backgroundRepeat = "no-repeat";
                }
                // Update composer avatar
                const composer = document.getElementById("composerAvatar");
                if (composer) {
                    composer.textContent = "";
                    composer.style.backgroundImage = 'url("' + dataUrl + '")';
                    composer.style.backgroundSize = "cover";
                    composer.style.backgroundPosition = "center";
                    composer.style.backgroundRepeat = "no-repeat";
                }
                // Update feed avatars
                document.querySelectorAll('.avatar, .mini-avatar').forEach(el => {
                    if (el.id !== "myAvatar" && el.id !== "composerAvatar") {
                        el.style.backgroundImage = 'url("' + dataUrl + '")';
                        el.style.backgroundSize = "cover";
                        el.style.backgroundPosition = "center";
                        el.style.backgroundRepeat = "no-repeat";
                        el.textContent = "";
                    }
                });
                if (window.me && window.me.profile) {
                    window.me.profile.avatar = dataUrl;
                }
                // Also automatically save to backend via profile API
                const token = localStorage.getItem("milanToken") || "";
                if (token) {
                    fetch("/api/profile", {
                        method: "PUT",
                        headers: {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer " + token
                        },
                        body: JSON.stringify({ avatar: dataUrl })
                    }).catch(err => console.warn("Avatar save to backend failed:", err));
                }
            };
            reader.readAsDataURL(file);
        });
    }
})();
</script>
