<style>
.milan-profile-dialog{
  width:min(720px,94vw);
  max-width:720px;
  padding:0;
  border:1px solid rgba(255,255,255,.12);
  border-radius:28px;
  background:linear-gradient(180deg,#111a2d 0%,#090e18 100%);
  color:#fff;
  box-shadow:0 40px 120px rgba(0,0,0,.65);
  overflow:hidden;
}

.milan-profile-dialog::backdrop{
  background:rgba(2,6,23,.75);
  backdrop-filter:blur(10px);
}

.milan-profile-card{
  margin:0;
  padding:0;
}

.milan-profile-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:24px 26px;
  border-bottom:1px solid rgba(255,255,255,.08);
  background:linear-gradient(135deg,rgba(109,93,252,.18),rgba(45,124,255,.08));
}

.milan-profile-head h2{
  margin:0;
  font-size:24px;
}

.milan-profile-head p{
  margin:5px 0 0;
  color:#91a0b8;
  font-size:12px;
}

.milan-profile-close{
  width:40px;
  height:40px;
  border:1px solid rgba(255,255,255,.1);
  border-radius:12px;
  background:rgba(255,255,255,.05);
  color:#fff;
  font-size:18px;
  cursor:pointer;
}

.milan-profile-body{
  display:grid;
  gap:14px;
  max-height:65vh;
  overflow:auto;
  padding:24px 26px;
}

.milan-field{
  display:grid;
  gap:7px;
  color:#e7edf7;
  font-size:12px;
  font-weight:800;
}

.milan-input{
  width:100%;
  padding:12px 13px;
  border:1px solid rgba(255,255,255,.1);
  border-radius:14px;
  background:rgba(255,255,255,.035);
  color:#fff;
  outline:none;
}

.milan-input:focus{
  border-color:#6d5dfc;
  box-shadow:0 0 0 3px rgba(109,93,252,.14);
}

.milan-textarea{
  min-height:110px;
  resize:vertical;
}

.milan-field-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.milan-profile-actions{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  padding:18px 26px 22px;
  border-top:1px solid rgba(255,255,255,.08);
  background:rgba(255,255,255,.02);
}

.milan-profile-cancel,
.milan-profile-save{
  padding:11px 18px;
  border-radius:12px;
  font-weight:800;
  cursor:pointer;
}

.milan-profile-cancel{
  border:1px solid rgba(255,255,255,.1);
  background:rgba(255,255,255,.04);
  color:#fff;
}

.milan-profile-save{
  border:0;
  background:linear-gradient(135deg,#6d5dfc,#2d7cff);
  color:#fff;
  box-shadow:0 10px 25px rgba(45,124,255,.2);
}

@media(max-width:600px){
  .milan-profile-dialog{width:96vw;border-radius:22px}
  .milan-profile-head,
  .milan-profile-body,
  .milan-profile-actions{padding-left:18px;padding-right:18px}
  .milan-field-grid{grid-template-columns:1fr}
}
</style>

